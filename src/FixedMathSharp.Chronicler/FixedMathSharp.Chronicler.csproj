<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <LangVersion Condition="'$(TargetFramework)' == 'netstandard2.1'">11.0</LangVersion>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <DisableMemoryPack Condition="'$(DisableMemoryPack)' == ''">false</DisableMemoryPack>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IncludeSymbols>true</IncludeSymbols>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Configurations>Debug;Release;ReleaseLean</Configurations>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <AssemblyName>FixedMathSharp.Chronicler</AssemblyName>
    <RootNamespace>FixedMathSharp.Chronicler</RootNamespace>
    <Authors>mrdav30</Authors>
    <Description>Exact Fixed64 simulation-time conversions and deterministic Chronicler record-hash extensions for FixedMathSharp values.</Description>
    <PackageTags>fixed-point;math;deterministic;lockstep;chronicler;timing;hash;replay;conformance;dotnet;game-development</PackageTags>
    <RepositoryUrl>https://github.com/mrdav30/FixedMathSharp</RepositoryUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'ReleaseLean'">
    <DisableMemoryPack>true</DisableMemoryPack>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DisableMemoryPack)' == 'true'">
    <PackageId>FixedMathSharp.Chronicler.Lean</PackageId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DisableMemoryPack)' != 'true'">
    <PackageId>FixedMathSharp.Chronicler</PackageId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' Or '$(Configuration)' == 'ReleaseLean'">
    <Optimize>true</Optimize>
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FixedMathSharp\FixedMathSharp.csproj">
      <AdditionalProperties Condition="'$(UseLocalLsfStack)' == 'true'">Configuration=$(Configuration);$(LocalLsfFixedMathSharpProperties)</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <!-- Dependencies and Package References -->
  <ItemGroup Condition="'$(DisableMemoryPack)' != 'true' And '$(UseLocalLsfStack)' != 'true'">
    <PackageReference Include="Chronicler.Core" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMemoryPack)' == 'true' And '$(UseLocalLsfStack)' != 'true'">
    <PackageReference Include="Chronicler.Core.Lean" Version="1.0.0" />
    <PackageReference Include="Chronicler.MemoryPackShim" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalLsfStack)' == 'true'">
    <ProjectReference Include="..\..\..\Chronicler\src\Chronicler\Chronicler.csproj" AdditionalProperties="Configuration=$(Configuration);$(LocalLsfChroniclerProperties)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalLsfStack)' == 'true' And ('$(Configuration)' == 'ReleaseLean' Or '$(DisableMemoryPack)' == 'true')">
    <ProjectReference Include="..\..\..\Chronicler\src\Chronicler.MemoryPackShim\Chronicler.MemoryPackShim.csproj" AdditionalProperties="Configuration=$(Configuration);$(LocalLsfChroniclerProperties)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\COPYRIGHT" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>