{
  "proseWrap": "preserve",
  "embeddedLanguageFormatting": "off",
  "printWidth": 100,
  "tabWidth": 2,
  "singleQuote": false,
  "semi": false,
  "trailingComma": "none",
  "overrides":
    [
      {
        "files": "*.md",
        "options":
          {
            "proseWrap": "always",
            "printWidth": 80,
            "tabWidth": 2,
            "useTabs": false,
            "endOfLine": "lf"
          }
      }
    ]
}
