{
  "metadata": [
    {
      "src": [
        {
          "files": ["src/FixedMathSharp/bin/Release/net8.0/FixedMathSharp.dll"],
          "src": "../.."
        }
      ],
      "dest": "obj/api"
    }
  ],
  "build": {
    "content": [
      { "files": ["index.md", "toc.yml"] },
      { "files": ["**/*.yml"], "src": "obj/api", "dest": "api" }
    ],
    "resource": [
      {
        "files": ["icon_128x128.png"],
        "src": "../../.assets",
        "dest": "assets"
      }
    ],
    "overwrite": [{ "files": ["overrides/*.md"] }],
    "output": "obj/_site",
    "template": ["default", "modern", "templates/fixedmathsharp"],
    "globalMetadata": {
      "_appName": "FixedMathSharp API",
      "_appTitle": "FixedMathSharp API",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_appLogoPath": "assets/icon_128x128.png",
      "_appFaviconPath": "assets/icon_128x128.png"
    }
  }
}
